# Every value must change before the first start; generate secrets with
# `openssl rand -hex 32`. See docs/deploy.md, Security checklist.
DOMAIN=play.example.com
POSTGRES_PASSWORD=change-me
# Sent by every client; it is not a secret, but must not stay "defaultkey".
NAKAMA_SERVER_KEY=change-me-client-key
# Session and refresh keys sign every token: long random, rotated together.
NAKAMA_SESSION_KEY=change-me-32-bytes
NAKAMA_REFRESH_KEY=change-me-32-bytes
# Console login (reports and player data live behind it).
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me
NAKAMA_CONSOLE_SIGNING_KEY=change-me
