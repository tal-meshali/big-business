# Every value must change before the first start; generate secrets with
# `openssl rand -hex 32`. See docs/deploy.md, Security checklist.
DOMAIN=play.example.com
POSTGRES_PASSWORD=change-me
# Sent by every client; it is not a secret, but must not stay "defaultkey".
NAKAMA_SERVER_KEY=change-me-client-key
# Session and refresh keys sign every token: long random, rotated together.
NAKAMA_SESSION_KEY=change-me-32-bytes
NAKAMA_REFRESH_KEY=change-me-32-bytes
# Console login (reports and player data live behind it).
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me
NAKAMA_CONSOLE_SIGNING_KEY=change-me
# Sign in with Apple: the app's bundle id (empty keeps Apple sign-in off; docs/deploy.md "Social sign-in").
APPLE_BUNDLE_ID=
# Google Sign-In: the OAuth web client id from the Google Cloud console. Not read by Nakama
# (id tokens are checked against Google's public certs); kept here as the one place to record it
# for the Android sign-in plugin config on the client.
GOOGLE_CLIENT_ID=
# Server-to-server RPCs (set_remote_config, analytics_report, revenuecat_webhook) are
# called with ?http_key=...: a secret. Nakama's default ("defaulthttpkey") must never ship.
NAKAMA_HTTP_KEY=change-me
# Skin shop (docs/deploy.md "Shop, push and analytics"). Empty keeps the shop in
# "opens soon" mode. The RevenueCat *secret* API key (sk_...) stays on the server.
REVENUECAT_API_KEY=
# Any long random string; RevenueCat sends it as the webhook's Authorization header.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat *public* app keys, for the client's purchase plugin (not read by Nakama).
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=
# "Your turn" pushes: a Firebase service account with the FCM Admin role. Empty sends nothing.
# FCM_PRIVATE_KEY is the JSON's private_key on one line, keeping its \n escapes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Designer uploads: a Google Cloud API key restricted to the Cloud Vision API. Empty sends
# every new picture to the moderation queue (docs/deploy.md "Designer").
GOOGLE_VISION_API_KEY=
