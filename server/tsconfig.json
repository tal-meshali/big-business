{
  "compilerOptions": {
    "target": "ES2016",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2016"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["nakama-runtime"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
